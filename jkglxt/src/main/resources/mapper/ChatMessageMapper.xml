<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jkglxt.mapper.ChatMessageMapper">
    <select id="getList" resultType="com.jkglxt.bean.ChatMessage">
        select * from chat_message order by create_time asc
    </select>
    
    <insert id="add" parameterType="com.jkglxt.bean.ChatMessage">
        insert into chat_message(user_id, username, content)
        values(#{userId}, #{username}, #{content})
    </insert>
    
    <delete id="delete">
        delete from chat_message where id = #{id}
    </delete>
</mapper>
